# ===== LLM（对话 / 路由 / 打分）—— 腾讯混元 TokenHub =====
# 控制台：https://console.cloud.tencent.com/tokenhub/api
# 可与模型网关共用同一 TokenHub Key
HUNYUAN_API_KEY=sk-replace-with-your-tokenhub-key
# 也可用 OPENAI_API_KEY / TOKENHUB_API_KEY 作为别名（优先 HUNYUAN_API_KEY）
# OPENAI_API_KEY=
# 对话默认中国站（与 Key 地域一致；国际站为 https://tokenhub-intl.tencentmaas.com/v1，用错会 401）
OPENAI_API_BASE=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=hy3
# LLM_STRUCTURED_METHOD=json_schema

# ===== Embedding（向量化）—— TokenHub（国内站）=====
# curl 示例：POST https://tokenhub.tencentmaas.com/v1/embeddings
#   model=kinfra-text-embedding-0.6b（固定 1024 维）
# 推荐与问答密钥分开填写；未设时才会回退到 HUNYUAN_API_KEY
EMBEDDING_API_KEY=sk-replace-with-your-embedding-key
EMBEDDING_API_BASE=https://tokenhub.tencentmaas.com/v1
EMBEDDING_MODEL=kinfra-text-embedding-0.6b
# TokenHub kinfra 维度固定，一般无需也不要强传 dimensions
# EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# ===== 数据与向量库 =====
DATA_DIR=./data/md
PERSISTANT_STORAGE_DIR=./db_md
# 换 Embedding 模型后首次请设为 True，建库成功后再改回 False
REBUILD_VECTORSTORE=False

DEBUG=False
API_HOST=0.0.0.0
API_PORT=14052
REGENERATION_THRESHOLD=5
RERETREVIAL_THRESHOLD=3
